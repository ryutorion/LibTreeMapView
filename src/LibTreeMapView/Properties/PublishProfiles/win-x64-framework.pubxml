<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET ランタイムを同梱しない発行プロファイル (x64)。
  発行先のサイズは小さくなるが、実行する側に .NET 10 デスクトップ ランタイムが必要。

  コマンドライン: dotnet publish src/LibTreeMapView -f net10.0-windows10.0.19041.0 -p:PublishProfile=win-x64-framework
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\publish\win-x64-framework\</PublishDir>

    <SelfContained>false</SelfContained>

    <!-- Windows App SDK は同梱する (別途インストールしなくても動くようにするため)。 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
