<?xml version="1.0" encoding="utf-8"?>
<!--
  配布用の発行プロファイル (x64)。
  .NET ランタイムと Windows App SDK を同梱するので、発行先のフォルダーをそのまま渡せば
  何もインストールしていない Windows でも実行できる。

  Visual Studio: プロジェクトを右クリック → 発行 → このプロファイルを選ぶ
  コマンドライン: dotnet publish src/LibTreeMapView -f net10.0-windows10.0.19041.0 -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\publish\win-x64\</PublishDir>

    <!-- .NET ランタイムと Windows App SDK を同梱する。 -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- 起動時の JIT を減らして初回表示を速くする。 -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- MAUI + WinUI では単一ファイル発行とトリミングは使えない。 -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
